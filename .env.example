GMAIL_EMAIL=dijiaozhibei@gmail.com
GMAIL_APP_PASSWORD=pfca nrvg bqqb hthu
GMAIL_POP3_HOST=pop.gmail.com
GMAIL_POP3_PORT=995

# 账户密码模板（{alias} 会被替换为别名序号）
ACCOUNT_PASSWORD=AetherTest123!

# 批处理设置
BATCH_START=2
BATCH_END=10
ACCOUNT_EMAIL_BASE=dijiaozhibei

# Aether 配置
AETHER_BASE_URL=https://to-aether.com
AETHER_API_BASE=https://to-aether.com/api/v1

# CapSolver API Key（用于绕过 Cloudflare Turnstile）
# 如果没有，请在注册前通过 Playwright 手动获取 Turnstile Token
CAPSOLVER_API_KEY=

# API Key 分组配置
# 每注册一个账户，会为所有可用分组创建 API Key
# 不设置此值则自动创建所有分组

# 可选：预设分组名称列表（逗号分隔），不设置则为所有可用分组
TARGET_GROUPS=
